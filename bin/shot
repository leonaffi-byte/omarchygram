#!/usr/bin/env bash
set -euo pipefail

name=${1:?usage: bin/shot NAME [CHAT_TITLE] [SECONDS]}
chat_title=${2:-}
wait_seconds=${3:-3}
app=./target/debug/omarchygram
output=target/shots/${name}.png

if [[ ! -x "$app" ]]; then
  echo "bin/shot: $app is missing; build it first" >&2
  exit 1
fi

mkdir -p target/shots

if [[ -n "$chat_title" ]]; then
  OMG_SMOKE_OPEN="$chat_title" "$app" --smoke &
else
  "$app" --smoke &
fi
app_pid=$!

cleanup() {
  kill "$app_pid" 2>/dev/null || true
  wait "$app_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

sleep "$wait_seconds"
if ! clients_json=$(hyprctl clients -j); then
  echo "bin/shot: could not query Hyprland" >&2
  exit 1
fi
geometry=$(jq -r '.[] | select(.class == "dev.leoom.Omarchygram") | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' <<<"$clients_json" | head -n 1)
if [[ -z "$geometry" ]]; then
  echo "bin/shot: Omarchygram window not found" >&2
  exit 1
fi

grim -g "$geometry" "$output"
echo "$output"
